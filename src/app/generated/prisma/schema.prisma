generator client {
  provider = "prisma-client-js"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model JumpRequest {
  id                   String       @id @default(cuid())
  mission              String
  destinationYear      Int
  plutoniumCores       Int
  suppressParadoxCheck Boolean      @default(false)
  createdAt            DateTime     @default(now())
  crew                 CrewMember[]
}

model CrewMember {
  id            String      @id @default(cuid())
  name          String
  birthYear     Int
  jumpRequest   JumpRequest @relation(fields: [jumpRequestId], references: [id])
  jumpRequestId String
}
